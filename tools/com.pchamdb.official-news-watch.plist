<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 公式お知らせ監視を毎日 09:05 / 18:05 に回す launchd 設定(2026-09-03)。
     入れ方(阿部さんが1回だけ実行):
       cp tools/com.pchamdb.official-news-watch.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pchamdb.official-news-watch.plist
     外し方: launchctl bootout gui/$(id -u)/com.pchamdb.official-news-watch
     今すぐ試す: launchctl kickstart gui/$(id -u)/com.pchamdb.official-news-watch -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.pchamdb.official-news-watch</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/masamichi/Documents/ポケモンDB/tools/_watch_official_news_daily.sh</string>
  </array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/masamichi/Library/Logs/pchamdb_official_news_watch.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/masamichi/Library/Logs/pchamdb_official_news_watch.launchd.log</string>
</dict></plist>
